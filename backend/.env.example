# ───────────────────────────────────────────────────────────────────────
# Dory.md backend environment
# Copy this file to `.env` and fill in the values your deployment needs.
# Every variable here is read via `os.getenv(...)` somewhere in the code.
# ───────────────────────────────────────────────────────────────────────

# ── Required ───────────────────────────────────────────────────────────

# DORY_ENV controls secure-by-default behaviour. Anything other than
# "dev"/"development" is treated as production (rate limiting on, demo login off).
DORY_ENV=development

# DORY_JWT_SECRET is REQUIRED in every environment — there is no fallback. The app
# refuses to boot without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DORY_JWT_SECRET=replace-me-with-random-32-bytes

# CORS: comma-separated list of exact origins allowed to call the API.
DORY_CORS_ORIGINS=http://localhost:5173

# ── LLM provider (optional but recommended) ────────────────────────────
# Without an API key the LLM-driven features (quiz generation, category
# classification, /api/ai/summarize|expand|optimize) degrade gracefully:
# quizzes fall back to a hardcoded bank, classification stays "Other", etc.

# Provider: groq | openai | anthropic | ollama (any OpenAI-compatible).
LLM_PROVIDER=groq
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Only the key matching LLM_PROVIDER is consulted.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=          # only if LLM_PROVIDER=openai

# Ollama (local): only used if LLM_PROVIDER=ollama. Defaults to the standard
# port; uncomment to override.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Observability & limits ─────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR (default INFO).
# LOG_LEVEL=INFO
# Requests/min/client-IP on auth + AI endpoints (default 60; 0 disables).
# Inert when DORY_ENV=dev. Production gets protection by default.
# DORY_RATE_LIMIT_PER_MIN=60

# ── Test / advanced (rarely used) ──────────────────────────────────────

# Override the SQLite path. Tests set this to a temp file; you almost
# never set it manually.
# DORY_DB_PATH=/path/to/dory.db

# Override the ChromaDB vector-store directory (defaults to backend/data/chroma).
# DORY_CHROMA_PATH=/path/to/chroma

# Skip the SentenceTransformer warm-up at startup. Faster boot, slower
# first ingest/search call (model loads on demand).
# DORY_SKIP_WARMUP=1
