# LLM Provider — switch without any code changes
# Options: groq | ollama | anthropic
LLM_PROVIDER=groq
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# API keys (only the one matching LLM_PROVIDER is needed)
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# App
DORY_ENV=dev
# JWT_SECRET is REQUIRED unless DORY_ENV=dev. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
